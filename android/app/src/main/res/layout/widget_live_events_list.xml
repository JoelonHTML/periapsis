<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_live_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_bg" android:scaleType="fitXY"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="10dp">
<TextView android:id="@+id/wl_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#94a3b8" android:maxLines="1" android:ellipsize="end" android:textAllCaps="true"/>
<LinearLayout android:id="@+id/wl_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp"><TextView android:id="@+id/wl_when1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#22d3ee" android:maxLines="1" android:ellipsize="end" android:layout_marginEnd="8dp"/><TextView android:id="@+id/wl_name1" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#e2e8f0" android:maxLines="1" android:ellipsize="end" android:layout_weight="1"/></LinearLayout>
<LinearLayout android:id="@+id/wl_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp"><TextView android:id="@+id/wl_when2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#22d3ee" android:maxLines="1" android:ellipsize="end" android:layout_marginEnd="8dp"/><TextView android:id="@+id/wl_name2" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#e2e8f0" android:maxLines="1" android:ellipsize="end" android:layout_weight="1"/></LinearLayout>
<LinearLayout android:id="@+id/wl_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp"><TextView android:id="@+id/wl_when3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#22d3ee" android:maxLines="1" android:ellipsize="end" android:layout_marginEnd="8dp"/><TextView android:id="@+id/wl_name3" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#e2e8f0" android:maxLines="1" android:ellipsize="end" android:layout_weight="1"/></LinearLayout>
<LinearLayout android:id="@+id/wl_row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp"><TextView android:id="@+id/wl_when4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#22d3ee" android:maxLines="1" android:ellipsize="end" android:layout_marginEnd="8dp"/><TextView android:id="@+id/wl_name4" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#e2e8f0" android:maxLines="1" android:ellipsize="end" android:layout_weight="1"/></LinearLayout>

</LinearLayout>
</FrameLayout>
