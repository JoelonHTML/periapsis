<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_live_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_bg" android:scaleType="fitXY"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="12dp">
<TextView android:id="@+id/wl_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#94a3b8" android:maxLines="1" android:ellipsize="end" android:textAllCaps="true"/>
<TextView android:id="@+id/wl_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="17sp" android:textColor="#e2e8f0" android:maxLines="3" android:ellipsize="end" android:textStyle="bold" android:layout_marginTop="4dp"/>
<TextView android:id="@+id/wl_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#22d3ee" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="6dp"/>
<TextView android:id="@+id/wl_rel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#94a3b8" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
</FrameLayout>
