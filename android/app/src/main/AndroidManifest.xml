<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Widget taps: periapsis://open/<route> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="periapsis" android:host="open" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- ===== Home-screen widgets: sky widgets (framework agent) ===== -->
        <receiver
            android:name=".widgets.PlanetsWidgetSmall"
            android:label="@string/widget_name_planets_small"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_planets_small" />
        </receiver>
        <receiver
            android:name=".widgets.PlanetsWidget"
            android:label="@string/widget_name_planets"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_planets" />
        </receiver>
        <receiver
            android:name=".widgets.PlanetsWidgetWide"
            android:label="@string/widget_name_planets_wide"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_planets_wide" />
        </receiver>
        <receiver
            android:name=".widgets.PlanetsWidgetLarge"
            android:label="@string/widget_name_planets_large"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_planets_large" />
        </receiver>
        <receiver
            android:name=".widgets.MoonWidgetSmall"
            android:label="@string/widget_name_moon_small"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_moon_small" />
        </receiver>
        <receiver
            android:name=".widgets.MoonWidget"
            android:label="@string/widget_name_moon"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_moon" />
        </receiver>
        <receiver
            android:name=".widgets.SunWidget"
            android:label="@string/widget_name_sun"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_sun" />
        </receiver>
        <receiver
            android:name=".widgets.TonightWidget"
            android:label="@string/widget_name_tonight"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_tonight" />
        </receiver>

        <!-- ===== Home-screen widgets: LIVE widgets (classes + xml/widget_info_* owned by the live-widgets agent) ===== -->
        <receiver
            android:name=".widgets.EventsWidget"
            android:label="@string/widget_live_name_events"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_events" />
        </receiver>
        <receiver
            android:name=".widgets.EventsWidgetLarge"
            android:label="@string/widget_live_name_events_large"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_events_large" />
        </receiver>
        <receiver
            android:name=".widgets.IssWidget"
            android:label="@string/widget_live_name_iss"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_iss" />
        </receiver>
        <receiver
            android:name=".widgets.IssWidgetWide"
            android:label="@string/widget_live_name_iss_wide"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_iss_wide" />
        </receiver>
        <receiver
            android:name=".widgets.LaunchWidget"
            android:label="@string/widget_live_name_launch"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_launch" />
        </receiver>
        <receiver
            android:name=".widgets.KpWidget"
            android:label="@string/widget_live_name_kp"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_kp" />
        </receiver>
        <!-- ===== end widgets ===== -->
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app update: lets the app hand the downloaded APK to the system installer (the user still confirms) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Satellites / Tonight: observer position for passes and the sky (coarse is enough) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Tonight: local reminders for passes and sky events -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
