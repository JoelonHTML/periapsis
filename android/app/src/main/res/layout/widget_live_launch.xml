<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_live_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_bg" android:scaleType="fitXY"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp">
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" >
<TextView android:id="@+id/wl_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#94a3b8" android:maxLines="1" android:ellipsize="end" android:textAllCaps="true"/>
<TextView android:id="@+id/wl_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#e2e8f0" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
<TextView android:id="@+id/wl_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#94a3b8" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end" android:layout_marginStart="8dp">
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
<TextView android:id="@+id/wl_tminus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#94a3b8" android:maxLines="1" android:ellipsize="end" android:text="T− "/>
<Chronometer android:id="@+id/wl_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold" android:textColor="#22d3ee"/>
<TextView android:id="@+id/wl_now" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#22d3ee" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
</LinearLayout>
<TextView android:id="@+id/wl_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#e2e8f0" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
</LinearLayout>
</FrameLayout>
