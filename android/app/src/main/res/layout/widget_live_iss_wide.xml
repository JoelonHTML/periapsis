<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_live_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_bg" android:scaleType="fitXY"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp">
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" >
<TextView android:id="@+id/wl_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#94a3b8" android:maxLines="1" android:ellipsize="end" android:textAllCaps="true"/>
<Chronometer android:id="@+id/wl_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold" android:textColor="#22d3ee"/>
<TextView android:id="@+id/wl_now" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:textColor="#22d3ee" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
<TextView android:id="@+id/wl_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#e2e8f0" android:maxLines="1" android:ellipsize="end" />
<TextView android:id="@+id/wl_extra" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#94a3b8" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
</LinearLayout>
</FrameLayout>
